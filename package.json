{
  "name": "zhizheng-gov-exam",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run verify",
    "test:api": "npm run build && node --test --test-concurrency=1 tests/api.integration.test.mjs",
    "test:ui": "npm run build && node --test --test-concurrency=1 tests/ui.smoke.test.mjs",
    "test:unit": "tsx --test tests/model-url.test.ts tests/material-html.test.ts tests/missing-question-materials.test.ts tests/missing-image-audit.test.ts tests/missing-direct-question-images.test.ts tests/question-scope.test.ts tests/difficulty.test.ts tests/android-study-plan-bridge.test.ts tests/study-plan-completion.test.ts tests/study-plan-timing.test.ts tests/learning-analysis.test.ts tests/daily-check-in.test.ts",
    "verify": "npm run lint && npx prisma validate && npm run build && npm run test:unit && node --test --test-concurrency=1 tests/api.integration.test.mjs tests/ui.smoke.test.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:import:public": "tsx scripts/import-public-question-bank.ts && tsx scripts/localize-question-images.ts",
    "db:import:bala": "tsx scripts/import-bala-question-bank.ts && tsx scripts/localize-question-images.ts",
    "db:import:huatu": "tsx scripts/import-huatu-question-bank.ts && tsx scripts/localize-question-images.ts",
    "db:localize:images": "tsx scripts/localize-question-images.ts",
    "db:repair:images": "tsx scripts/repair-question-image-anomalies.ts",
    "db:repair:materials": "tsx scripts/repair-bala-materials.ts",
    "db:repair:missing-materials": "tsx scripts/repair-missing-question-materials.ts",
    "db:audit:missing-images": "tsx scripts/audit-missing-question-images.ts",
    "db:repair:missing-direct-images": "tsx scripts/repair-missing-direct-question-images.ts",
    "db:audit:questions": "tsx scripts/audit-question-bank.ts",
    "db:fix:questions": "tsx scripts/audit-question-bank.ts --fix",
    "db:score:difficulty": "tsx scripts/score-question-difficulty.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "playwright-core": "^1.61.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  }
}
